# Copy to .env (git-ignored). Values are read by config.toml via ${VAR}
# and by docker-compose. Never commit real keys.

# --- model provider keys (reference them from [llm].api_key) -------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- wevvy overrides (all optional; take precedence over config.toml) --------
# Path to the TOML config file
# WEVVY_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.wevvy)
# WEVVY_DATA_DIR=~/.wevvy
# The agent's files (default: agent.workspace from config; ./workspace when the current directory has one, else <data_dir>/workspace)
# WEVVY_WORKSPACE=./workspace
# openai | openai_responses | chatgpt | a catalogue id (deepseek, bailian, zhipu, openrouter, ...)
# WEVVY_LLM_PROVIDER=openai
# WEVVY_LLM_MODEL=deepseek-flash
# WEVVY_LLM_BASE_URL=https://api.deepseek.com
# WEVVY_LLM_API_KEY=
# auto | native | prompt
# WEVVY_LLM_TOOL_MODE=native
# ask | strict | auto
# WEVVY_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# WEVVY_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: file in data dir)
# WEVVY_VAULT_KEY=
# App server (`wevvy serve`): bind address, port, and a fixed access token
# WEVVY_SERVER_HOST=0.0.0.0
# WEVVY_SERVER_PORT=8787
# WEVVY_SERVER_TOKEN=
# set to 1 to run tests marked `live` against the configured model
# WEVVY_LIVE=0
