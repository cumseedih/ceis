# Copy to .env (git-ignored). Values are read by config.toml via ${VAR}
# and by docker-compose. Never commit real keys.

# --- model provider keys (reference them from [llm].api_key) -------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- ceis overrides (all optional; take precedence over config.toml) --------
# Path to the TOML config file
# CEIS_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.ceis)
# CEIS_DATA_DIR=~/.ceis
# The agent's files (default: agent.workspace from config; ./workspace when the current directory has one, else <data_dir>/workspace)
# CEIS_WORKSPACE=./workspace
# openai | openai_responses | chatgpt | a catalogue id (deepseek, bailian, zhipu, openrouter, ...)
# CEIS_LLM_PROVIDER=openai
# CEIS_LLM_MODEL=deepseek-flash
# CEIS_LLM_BASE_URL=https://api.deepseek.com
# CEIS_LLM_API_KEY=
# auto | native | prompt
# CEIS_LLM_TOOL_MODE=native
# ask | strict | auto
# CEIS_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# CEIS_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: file in data dir)
# CEIS_VAULT_KEY=
# App server (`ceis serve`): bind address, port, and a fixed access token
# CEIS_SERVER_HOST=0.0.0.0
# CEIS_SERVER_PORT=8787
# CEIS_SERVER_TOKEN=
# set to 1 to run tests marked `live` against the configured model
# CEIS_LIVE=0
