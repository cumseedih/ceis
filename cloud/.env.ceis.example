# ceis relay — template. Copy to cloud/.env and fill in, then restart the relay.
# cloud/.env is git-ignored; this template carries no credentials and is safe to commit.
#
# How sign-in codes reach people:
#   log    — codes are printed to the server log only (development; the default here)
#   smtp   — codes go by e-mail through your SMTP server (production choice for ceis)
#   aliyun — codes go by SMS to mainland-China numbers through Alibaba Cloud
#   both   — smtp for e-mail addresses, aliyun for phone numbers
#
# ceis is e-mail first: text codes reach mainland-China numbers only, so the login
# screen presents e-mail as the reliable route. The provider chosen for ceis is
# Brevo: the block below is pre-filled with Brevo's relay host and port. Fill in
# SMTP_USER, SMTP_PASSWORD and SMTP_FROM with your own values to go live.
CODE_SENDER=smtp

# SMTP for sign-in codes (Brevo relay; used when CODE_SENDER=smtp or both).
# SMTP_USER is the SMTP login shown in Brevo under Settings, SMTP & API (it is not
# always your account e-mail). SMTP_PASSWORD is the SMTP key generated on that
# same page, never your Brevo account password. SMTP_FROM must be an address on
# a domain you have verified in Brevo (SPF and DKIM records added at your DNS
# host), or the codes will land in spam or be refused.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ceis <no-reply@wevvy.in>

# Credit policy (USD_CNY 7.1): ALLOWANCE_CNY 71 is $10 for any address;
# PRIVILEGED_ALLOWANCE_CNY 3550 is $500 for addresses at PRIVILEGED_DOMAIN.
ALLOWANCE_CNY=71
INVITE_BONUS_CNY=0
PRIVILEGED_DOMAIN=wevvy.in
PRIVILEGED_ALLOWANCE_CNY=3550
