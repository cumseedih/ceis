# Production relay on the VPS (relay.wevvy.in). Copy to relay.env on the VPS,
# fill in the placeholders, never commit the filled file.
#
# Generate the secrets with: openssl rand -hex 32

# What the apps use as the relay address.
PUBLIC_BASE=https://relay.wevvy.in

# Secrets. Rotating CLOUD_SECRET orphans every account and every code in flight,
# so back it up with the database.
CLOUD_SECRET=PASTE_GENERATED_HEX_HERE
CLOUD_ADMIN_TOKEN=PASTE_GENERATED_HEX_HERE

# Sign-in codes go out by e-mail through Brevo.
CODE_SENDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=PASTE_BREVO_SMTP_LOGIN_HERE
SMTP_PASSWORD=PASTE_BREVO_SMTP_KEY_HERE
SMTP_FROM=wevvy <no-reply@wevvy.in>

# Credit policy, in yuan at USD_CNY 7.1 (the apps show dollars).
# @wevvy.in addresses start with $1000, everyone else with $10, invite bonus 0.
ALLOWANCE_CNY=71
PRIVILEGED_DOMAIN=wevvy.in
PRIVILEGED_ALLOWANCE_CNY=7100
INVITE_BONUS_CNY=0
USD_CNY=7.1

# Who may sign in. SIGNUP_OPEN=1 lets anyone register.
SIGNUP_OPEN=1
ALLOWED_IDENTIFIERS=

# The cloud model behind wevvy Cloud chat. The relay needs an Alibaba Cloud
# Model Studio (DashScope) API key as UPSTREAM_KEY, because the model names it
# serves are DashScope's and its default endpoint is DashScope's
# OpenAI-compatible endpoint. Without a key, sign-in and credits still work,
# but cloud-model chat fails. Create a key in the Model Studio console and put
# it in relay.env on the VPS (never commit it); a key from another provider
# needs a separate decision first.
UPSTREAM_KEY=PASTE_DASHSCOPE_API_KEY_HERE
