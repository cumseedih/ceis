# One sync of the project site's mirror; ceis-site-mirror.timer runs it every minute.
# Installed by install.sh, which also links sync.sh to /usr/local/bin/ceis-site-mirror.
[Unit]
Description=ceis site mirror (ceis.cn): sync from GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# WWW_ROOT / MIRROR_* overrides, if any (see sync.sh); absent is fine
EnvironmentFile=-/etc/default/ceis-site-mirror
ExecStart=/usr/local/bin/ceis-site-mirror
